<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MisFinanzas.App.Vistas.AjustesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MisFinanzas.App.ViewModels"
    x:DataType="vm:AjustesViewModel"
    Shell.NavBarIsVisible="False"
    Title="Ajustes">

    <ContentPage.Resources>

        <!-- Fila de categoría -->
        <DataTemplate x:Key="PlantillaCategoria" x:DataType="vm:CategoriaAjusteItem">
            <Grid Padding="2,8" ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TocarCommand}" />
                </Grid.GestureRecognizers>
                <Border Style="{StaticResource Burbuja}" BackgroundColor="{AppThemeBinding Light={StaticResource LilaSuave}, Dark={StaticResource LilaSuaveOscuro}}">
                    <Label Text="{Binding Emoji}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding Nombre}" Style="{StaticResource TextoFuerte}" />
                    <Label Text="{Binding Detalle}" Style="{StaticResource TextoSuave}" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource ColorTextoSuave}, Dark={StaticResource ColorTextoSuaveOscuro}}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <!-- Fila de gasto permanente -->
        <DataTemplate x:Key="PlantillaGastoFijo" x:DataType="vm:GastoFijoItem">
            <Grid Padding="2,8" ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TocarCommand}" />
                </Grid.GestureRecognizers>
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding EstaTerminado}" Value="True">
                        <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </Grid.Triggers>
                <Border Style="{StaticResource Burbuja}">
                    <Label Text="{Binding Emoji}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding Concepto}" Style="{StaticResource TextoFuerte}" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Detalle}" Style="{StaticResource TextoSuave}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                    <Label Text="{Binding MontoTexto}" Style="{StaticResource Monto}" />
                    <Border Style="{StaticResource Pildora}" BackgroundColor="{AppThemeBinding Light={StaticResource MentaSuave}, Dark={StaticResource MentaSuaveOscuro}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding EstaActivo}" Value="False">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LilaSuave}, Dark={StaticResource LilaSuaveOscuro}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding EstadoTexto}" FontSize="11" FontFamily="RedondaMedia" TextColor="{AppThemeBinding Light={StaticResource Menta}, Dark={StaticResource MentaOscuro}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding EstaActivo}" Value="False">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Lila}, Dark={StaticResource LilaOscuro}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>

    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="18">

            <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Image Source="logo_moneda.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    <Label Text="Mis finanzas" Style="{StaticResource TextoSuave}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="Ajustes" Style="{StaticResource TituloPagina}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Gastos permanentes -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="🔁 Gastos fijos" Style="{StaticResource TituloSeccion}" />
                            <Label Text="{Binding TotalGastosFijosTexto}" Style="{StaticResource TextoSuave}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="+" Style="{StaticResource BotonCirculo}"
                                Command="{Binding AgregarGastoFijoCommand}" />
                    </Grid>
                    <Label Text="Aparecen solos cada mes. Agrega aquí tus cuentas de luz, agua, suscripciones…"
                           Style="{StaticResource TextoSuave}" IsVisible="{Binding SinGastosFijos}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding GastosFijos}"
                                         BindableLayout.ItemTemplate="{StaticResource PlantillaGastoFijo}" />
                </VerticalStackLayout>
            </Border>

            <!-- Categorías -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="🏷️ Categorías" Style="{StaticResource TituloSeccion}" />
                        <Button Grid.Column="1" Text="+" Style="{StaticResource BotonCirculo}"
                                Command="{Binding AgregarCategoriaCommand}" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categorias}"
                                         BindableLayout.ItemTemplate="{StaticResource PlantillaCategoria}" />

                    <VerticalStackLayout Spacing="2" IsVisible="{Binding HayArchivadas}" Opacity="0.6">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Linea}, Dark={StaticResource LineaOscuro}}" Margin="0,8" />
                        <Label Text="📦 Archivadas" Style="{StaticResource TextoSuave}" FontFamily="RedondaMedia" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CategoriasArchivadas}"
                                             BindableLayout.ItemTemplate="{StaticResource PlantillaCategoria}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Apariencia -->
            <Border Style="{StaticResource Tarjeta}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CambiarTemaCommand}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="1">
                        <Label Text="🌙 Apariencia" Style="{StaticResource TituloSeccion}" />
                        <Label Text="{Binding TemaTexto}" Style="{StaticResource TextoSuave}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="22" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextoSuave}, Dark={StaticResource ColorTextoSuaveOscuro}}" />
                </Grid>
            </Border>

            <!-- Alertas -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="🔔 Alertas" Style="{StaticResource TituloSeccion}" Margin="0,0,0,6" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="2,8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditarUmbralCommand}" CommandParameter="SubidaCuenta" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Cuenta fija que sube" Style="{StaticResource TextoFuerte}" />
                            <Label Text="Comparada con el mes anterior" Style="{StaticResource TextoSuave}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding UmbralSubidaTexto}" Style="{StaticResource Monto}" TextColor="{AppThemeBinding Light={StaticResource Lila}, Dark={StaticResource LilaOscuro}}" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="2,8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditarUmbralCommand}" CommandParameter="GastoIngreso" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Gasto del mes" Style="{StaticResource TextoFuerte}" />
                            <Label Text="Porcentaje de lo que ingresa" Style="{StaticResource TextoSuave}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding UmbralGastoTexto}" Style="{StaticResource Monto}" TextColor="{AppThemeBinding Light={StaticResource Lila}, Dark={StaticResource LilaOscuro}}" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="2,8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditarUmbralCommand}" CommandParameter="AlLimite" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Presupuesto al límite" Style="{StaticResource TextoFuerte}" />
                            <Label Text="Porcentaje usado de una categoría" Style="{StaticResource TextoSuave}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding UmbralLimiteTexto}" Style="{StaticResource Monto}" TextColor="{AppThemeBinding Light={StaticResource Lila}, Dark={StaticResource LilaOscuro}}" VerticalOptions="Center" />
                    </Grid>

                    <Label Text="Toca un valor para cambiarlo." Style="{StaticResource TextoSuave}" Margin="2,4,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
