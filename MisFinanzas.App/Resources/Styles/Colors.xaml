<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Paleta "lila pastel" con modo claro y modo oscuro.
        Cada color tiene su versión "…Oscuro"; las vistas usan AppThemeBinding para elegir la que corresponde.
        Todos los textos cumplen un contraste ≥ 4,5:1 sobre su fondo en ambos modos.
        Si cambias un color, revisa también Platforms/Android/Resources/values/colors.xml.
    -->

    <!-- ───────── Modo claro ───────── -->

    <!-- Base -->
    <Color x:Key="Fondo">#FAF7FF</Color>
    <Color x:Key="Superficie">#FFFFFF</Color>
    <Color x:Key="Linea">#ECE4F7</Color>
    <Color x:Key="ColorTexto">#352F4A</Color>
    <Color x:Key="ColorTextoSuave">#6B6382</Color>

    <!-- Acentos: lila (principal) y rosa (secundario) -->
    <Color x:Key="Lila">#7650C4</Color>
    <Color x:Key="LilaClaro">#C4B1F2</Color>
    <Color x:Key="LilaSuave">#EFE8FD</Color>
    <Color x:Key="Rosa">#A8406F</Color>
    <Color x:Key="RosaClaro">#F5B4CF</Color>
    <Color x:Key="RosaSuave">#FCEAF2</Color>
    <!-- Texto sobre un fondo lila (botón principal, opción elegida) -->
    <Color x:Key="SobreLila">#FFFFFF</Color>

    <!-- Estados -->
    <Color x:Key="Menta">#237A5D</Color>
    <Color x:Key="MentaClaro">#7FD8BE</Color>
    <Color x:Key="MentaSuave">#E3F6EE</Color>
    <Color x:Key="Coral">#B33A53</Color>
    <Color x:Key="CoralClaro">#FF9AA8</Color>
    <Color x:Key="CoralSuave">#FDE9EC</Color>
    <Color x:Key="Ambar">#8A5A0C</Color>
    <Color x:Key="AmbarClaro">#FFC56E</Color>
    <Color x:Key="AmbarSuave">#FFF3DC</Color>

    <!-- Degradado de la tarjeta principal -->
    <Color x:Key="HeroInicio">#E7DDFF</Color>
    <Color x:Key="HeroFin">#FBE3F0</Color>

    <!-- ───────── Modo oscuro: violeta profundo y tonos apagados, nunca negro ni colores saturados ───────── -->

    <Color x:Key="FondoOscuro">#22202D</Color>
    <Color x:Key="SuperficieOscuro">#2C2939</Color>
    <Color x:Key="LineaOscuro">#3B3649</Color>
    <Color x:Key="ColorTextoOscuro">#ECE6F4</Color>
    <Color x:Key="ColorTextoSuaveOscuro">#B1A8C4</Color>

    <Color x:Key="LilaOscuro">#C9B8F5</Color>
    <Color x:Key="LilaClaroOscuro">#8E78D0</Color>
    <Color x:Key="LilaSuaveOscuro">#3A3253</Color>
    <Color x:Key="RosaOscuro">#F2B3CD</Color>
    <Color x:Key="RosaClaroOscuro">#C97FA3</Color>
    <Color x:Key="RosaSuaveOscuro">#45303F</Color>
    <Color x:Key="SobreLilaOscuro">#22202D</Color>

    <Color x:Key="MentaOscuro">#93DDC4</Color>
    <Color x:Key="MentaClaroOscuro">#5DB895</Color>
    <Color x:Key="MentaSuaveOscuro">#283F38</Color>
    <Color x:Key="CoralOscuro">#FFAAB7</Color>
    <Color x:Key="CoralClaroOscuro">#D9798A</Color>
    <Color x:Key="CoralSuaveOscuro">#4A2D35</Color>
    <Color x:Key="AmbarOscuro">#F2CF8C</Color>
    <Color x:Key="AmbarClaroOscuro">#CFA052</Color>
    <Color x:Key="AmbarSuaveOscuro">#433826</Color>

    <Color x:Key="HeroInicioOscuro">#3B3357</Color>
    <Color x:Key="HeroFinOscuro">#4A3149</Color>

    <!-- ───────── Nombres que usa la plantilla de MAUI (Styles.xaml) ───────── -->
    <Color x:Key="Primary">#7650C4</Color>
    <Color x:Key="PrimaryDark">#C9B8F5</Color>
    <Color x:Key="PrimaryDarkText">#22202D</Color>
    <Color x:Key="Secondary">#EFE8FD</Color>
    <Color x:Key="SecondaryDarkText">#C9B8F5</Color>
    <Color x:Key="Tertiary">#A8406F</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">#352F4A</Color>
    <Color x:Key="Magenta">#7650C4</Color>
    <Color x:Key="MidnightBlue">#352F4A</Color>
    <Color x:Key="OffBlack">#22202D</Color>

    <Color x:Key="Gray100">#ECE4F7</Color>
    <Color x:Key="Gray200">#DDD3EC</Color>
    <Color x:Key="Gray300">#C2B8D4</Color>
    <Color x:Key="Gray400">#9F95B3</Color>
    <Color x:Key="Gray500">#6B6382</Color>
    <Color x:Key="Gray600">#4D4664</Color>
    <Color x:Key="Gray900">#352F4A</Color>
    <Color x:Key="Gray950">#26213A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
