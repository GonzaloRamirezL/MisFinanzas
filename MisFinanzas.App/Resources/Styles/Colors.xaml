<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Paleta "lila pastel". Todos los textos cumplen contraste mínimo 4,4:1 sobre su fondo.
        Si cambias un color, revisa también Platforms/Android/Resources/values/colors.xml.
    -->

    <!-- Base -->
    <Color x:Key="Fondo">#FAF7FF</Color>
    <Color x:Key="Superficie">#FFFFFF</Color>
    <Color x:Key="Linea">#ECE4F7</Color>
    <Color x:Key="Texto">#352F4A</Color>
    <Color x:Key="TextoSuave">#6B6382</Color>

    <!-- Acentos: lila (principal) y rosa (secundario) -->
    <Color x:Key="Lila">#7650C4</Color>
    <Color x:Key="LilaClaro">#C4B1F2</Color>
    <Color x:Key="LilaSuave">#EFE8FD</Color>
    <Color x:Key="Rosa">#A8406F</Color>
    <Color x:Key="RosaClaro">#F5B4CF</Color>
    <Color x:Key="RosaSuave">#FCEAF2</Color>

    <!-- Estados -->
    <Color x:Key="Menta">#237A5D</Color>
    <Color x:Key="MentaClaro">#7FD8BE</Color>
    <Color x:Key="MentaSuave">#E3F6EE</Color>
    <Color x:Key="Coral">#B33A53</Color>
    <Color x:Key="CoralClaro">#FF9AA8</Color>
    <Color x:Key="CoralSuave">#FDE9EC</Color>
    <Color x:Key="Ambar">#8A5A0C</Color>
    <Color x:Key="AmbarClaro">#FFC56E</Color>
    <Color x:Key="AmbarSuave">#FFF3DC</Color>

    <!-- Degradado de la tarjeta principal -->
    <Color x:Key="HeroInicio">#E7DDFF</Color>
    <Color x:Key="HeroFin">#FBE3F0</Color>

    <!-- Nombres que usa la plantilla de MAUI (Styles.xaml). Apuntan a la paleta de arriba. -->
    <Color x:Key="Primary">#7650C4</Color>
    <Color x:Key="PrimaryDark">#C4B1F2</Color>
    <Color x:Key="PrimaryDarkText">#352F4A</Color>
    <Color x:Key="Secondary">#EFE8FD</Color>
    <Color x:Key="SecondaryDarkText">#C4B1F2</Color>
    <Color x:Key="Tertiary">#A8406F</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">#352F4A</Color>
    <Color x:Key="Magenta">#7650C4</Color>
    <Color x:Key="MidnightBlue">#352F4A</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#ECE4F7</Color>
    <Color x:Key="Gray200">#DDD3EC</Color>
    <Color x:Key="Gray300">#C2B8D4</Color>
    <Color x:Key="Gray400">#9F95B3</Color>
    <Color x:Key="Gray500">#6B6382</Color>
    <Color x:Key="Gray600">#4D4664</Color>
    <Color x:Key="Gray900">#352F4A</Color>
    <Color x:Key="Gray950">#26213A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
