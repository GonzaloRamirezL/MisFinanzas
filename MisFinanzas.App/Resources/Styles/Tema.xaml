<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Estilos propios de Mis Finanzas. Se usan con Style="{StaticResource Nombre}". -->

    <!-- Tarjetas -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieOscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Linea}, Dark={StaticResource LineaOscuro}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource LilaClaro}" Opacity="0.18" Radius="18" Offset="0,6" />
        </Setter>
    </Style>

    <Style x:Key="TarjetaAlerta" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CoralSuave}, Dark={StaticResource CoralSuaveOscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CoralSuave}, Dark={StaticResource CoralSuaveOscuro}}" />
        <Setter Property="Shadow" Value="{x:Null}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Círculo con emoji a la izquierda de cada fila -->
    <Style x:Key="Burbuja" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RosaSuave}, Dark={StaticResource RosaSuaveOscuro}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Etiquetas tipo "píldora" (Pagado / Pendiente / Por pagar) -->
    <Style x:Key="Pildora" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <!-- Textos -->
    <Style x:Key="TituloPagina" TargetType="Label">
        <Setter Property="FontFamily" Value="RedondaNegrita" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTexto}, Dark={StaticResource ColorTextoOscuro}}" />
    </Style>

    <Style x:Key="TituloSeccion" TargetType="Label">
        <Setter Property="FontFamily" Value="RedondaNegrita" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTexto}, Dark={StaticResource ColorTextoOscuro}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TextoFuerte" TargetType="Label">
        <Setter Property="FontFamily" Value="RedondaMedia" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTexto}, Dark={StaticResource ColorTextoOscuro}}" />
    </Style>

    <Style x:Key="TextoSuave" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextoSuave}, Dark={StaticResource ColorTextoSuaveOscuro}}" />
    </Style>

    <Style x:Key="Monto" TargetType="Label">
        <Setter Property="FontFamily" Value="RedondaNegrita" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTexto}, Dark={StaticResource ColorTextoOscuro}}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>

    <Style x:Key="MontoGrande" TargetType="Label">
        <Setter Property="FontFamily" Value="RedondaNegrita" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTexto}, Dark={StaticResource ColorTextoOscuro}}" />
    </Style>

    <Style x:Key="EtiquetaCampo" TargetType="Label">
        <Setter Property="FontFamily" Value="RedondaMedia" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextoSuave}, Dark={StaticResource ColorTextoSuaveOscuro}}" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- Botones -->
    <Style x:Key="BotonPrincipal" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Lila}, Dark={StaticResource LilaOscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SobreLila}, Dark={StaticResource SobreLilaOscuro}}" />
        <Setter Property="FontFamily" Value="RedondaNegrita" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style x:Key="BotonSuave" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LilaSuave}, Dark={StaticResource LilaSuaveOscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Lila}, Dark={StaticResource LilaOscuro}}" />
        <Setter Property="FontFamily" Value="RedondaNegrita" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="BotonTexto" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextoSuave}, Dark={StaticResource ColorTextoSuaveOscuro}}" />
        <Setter Property="FontFamily" Value="RedondaMedia" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- "Ver más / Ver menos" al pie de las listas largas -->
    <Style x:Key="BotonVerMas" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LilaSuave}, Dark={StaticResource LilaSuaveOscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Lila}, Dark={StaticResource LilaOscuro}}" />
        <Setter Property="FontFamily" Value="RedondaMedia" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="MinimumHeightRequest" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Botón redondo "+" de cada sección y flechas de mes -->
    <Style x:Key="BotonCirculo" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LilaSuave}, Dark={StaticResource LilaSuaveOscuro}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Lila}, Dark={StaticResource LilaOscuro}}" />
        <Setter Property="FontFamily" Value="RedondaNegrita" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Campos de formulario -->
    <Style x:Key="CajaCampo" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Fondo}, Dark={StaticResource FondoOscuro}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Linea}, Dark={StaticResource LineaOscuro}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="12,2" />
    </Style>

</ResourceDictionary>
