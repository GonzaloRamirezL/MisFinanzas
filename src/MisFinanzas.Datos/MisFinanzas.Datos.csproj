<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      sqlite-net-base es sqlite-net sin la librería nativa de SQLite incluida.
      La librería nativa la aporta SQLitePCLRaw.bundle_e_sqlite3 3.x, que reemplaza a
      bundle_green 2.1.x (marcada con una vulnerabilidad de severidad alta).
    -->
    <PackageReference Include="sqlite-net-base" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MisFinanzas.Core\MisFinanzas.Core.csproj" />
  </ItemGroup>

</Project>
